{
  "type": "object",
  "required": ["planId", "planHash", "contextSnapshotId", "contextDigest", "approvedBy", "approvedAt"],
  "properties": {
    "planId": { "type": "string", "minLength": 1 },
    "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contextSnapshotId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "editSetHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approvedBy": { "type": "string", "minLength": 1 },
    "approvedAt": { "type": "string", "format": "date-time" }
  }
}
