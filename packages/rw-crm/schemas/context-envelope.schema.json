{
  "type": "object",
  "required": ["task", "componentScope", "repositoryScope", "figmaLinks", "constraints", "approvals"],
  "properties": {
    "task": { "type": "string", "minLength": 1 },
    "componentScope": { "type": "array", "items": { "type": "string" } },
    "repositoryScope": { "type": "array", "items": { "type": "string" } },
    "figmaLinks": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "approvals": {
      "type": "object",
      "required": ["plan", "codeEdits"],
      "properties": { "plan": { "type": ["object", "null"] }, "codeEdits": { "type": ["object", "null"] } }
    }
  }
}
