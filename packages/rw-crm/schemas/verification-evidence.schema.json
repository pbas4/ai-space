{
  "type": "object",
  "required": ["name", "status"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["not-run", "passed", "failed", "skipped"] },
    "receiptId": { "type": "string", "minLength": 1 },
    "receiptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
