{
  "type": "object",
  "description": "Normalized repository classification and repository-specific delivery obligations.",
  "required": ["target", "evidence", "versioningRequired", "changelogRequired", "prTemplate", "verificationRules"],
  "properties": {
    "target": { "enum": ["rw-crm-components", "other", "ambiguous"] },
    "evidence": { "type": "array", "items": { "type": "object" } },
