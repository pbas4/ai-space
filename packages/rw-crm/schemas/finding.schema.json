{
  "type": "object",
  "required": ["id", "severity", "summary"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["info", "warning", "error"] },
    "summary": { "type": "string", "minLength": 1 },
    "evidenceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
